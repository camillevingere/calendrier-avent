{
  "name": "calendrier-avent-fyliz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/generer.ts && next dev",
    "build": "node scripts/generer.ts && node scripts/verifier.ts && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts",
    "cle": "node scripts/nouvelle-cle.ts",
    "chiffrer": "node --env-file-if-exists=.env.local scripts/chiffrer.ts",
    "robot": "node --env-file-if-exists=.env.local scripts/robot.ts",
    "apercu": "node --env-file-if-exists=.env.local scripts/apercu.ts",
    "verifier": "node scripts/verifier.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "marked": "18.2.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9"
  }
}
