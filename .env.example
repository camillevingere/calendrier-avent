# ── À mettre sur Vercel (Settings → Environment Variables) ──────────────
# Clé API Lumail (Settings → API dans Lumail).
LUMAIL_API_KEY=
# Secret qui signe le cookie « déjà inscrit ». Génère-le avec : openssl rand -base64 32
GATE_SECRET=
# Optionnel : tag posé sur les inscrits (défaut : calendrier-avent).
# LUMAIL_TAG=calendrier-avent

# ── JAMAIS sur Vercel : seulement dans .env.local et dans les secrets GitHub ──
# Clé maîtresse du contenu chiffré. Génère-la avec : pnpm cle
# CONTENU_CLE=
